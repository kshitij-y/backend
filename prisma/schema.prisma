generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

enum UserRole {
  MENTOR
  MENTEE
  ADMIN
}

enum OTPPurpose {
  SIGNUP
  FORGOT_PASSWORD
}

enum MentorPlanDuration {
  THREE_MONTH
  SIX_MONTH
  TWELVE_MONTH
}

enum MentorshipStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  avatar         String?
  bio            String?
  interests      String?
  goals          String?
  learningFocus  String?

  isVerified          Boolean   @default(false)
  onboardingCompleted Boolean   @default(false)
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile?

  menteeMentorships Mentorship[] @relation("MenteeMentorships")

  oAuthConnections OAuthConnection[]

  @@index([email])
  @@index([role])
}

model MentorProfile {
  id String @id @default(uuid())

  userId String @unique

  headline String?
  about    String?

  experienceYears Int?

  isAvailable Boolean @default(true)

  profileCompleted Boolean @default(false)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expertise   MentorExpertise[]
  mentorPlans MentorPlan[]
  mentorships Mentorship[]

  @@index([isAvailable])
}

model Expertise {
  id String @id @default(uuid())

  name String
  slug String @unique

  createdAt DateTime @default(now())

  mentors MentorExpertise[]
}

model MentorExpertise {
  id String @id @default(uuid())

  mentorProfileId String
  expertiseId     String

  yearsExperience Int?

  createdAt DateTime @default(now())

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  expertise Expertise @relation(fields: [expertiseId], references: [id], onDelete: Cascade)

  @@unique([mentorProfileId, expertiseId])

  @@index([mentorProfileId])
  @@index([expertiseId])
}

model MentorPlan {
  id String @id @default(uuid())

  mentorProfileId String

  duration MentorPlanDuration

  title       String?
  description String?

  price Float

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  mentorships Mentorship[]

  @@index([mentorProfileId])
  @@index([isActive])
}

model Mentorship {
  id String @id @default(uuid())

  mentorProfileId String
  menteeId        String

  mentorPlanId String

  status MentorshipStatus @default(ACTIVE)

  startDate DateTime?
  endDate   DateTime?

  streamChannelId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  mentee User @relation("MenteeMentorships", fields: [menteeId], references: [id], onDelete: Cascade)

  mentorPlan MentorPlan @relation(fields: [mentorPlanId], references: [id], onDelete: Cascade)

  sessions Session[]

  @@index([mentorProfileId])
  @@index([menteeId])
  @@index([status])
}

model Session {
  id String @id @default(uuid())

  mentorshipId String

  startTime DateTime
  endTime   DateTime

  googleMeetLink String?
  googleEventId  String?

  status SessionStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorship Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  @@index([mentorshipId])
  @@index([status])
  @@index([startTime])
}

model OTPVerification {
  id String @id @default(uuid())

  email String

  otpHash String

  purpose OTPPurpose

  expiresAt DateTime

  verified Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([purpose])
  @@index([expiresAt])
}

model OAuthConnection {
  id String @id @default(cuid())

  userId String

  provider String

  accessToken  String?
  refreshToken String?

  expiryDate DateTime?

  scopes String[]

  connected Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])

  @@index([provider])
  @@index([connected])
}